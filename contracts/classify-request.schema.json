{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "model": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "revision": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Capabilities",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "model",
        "revision"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "configured",
            "measured"
          ],
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "sample_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Preference": {
      "additionalProperties": false,
      "description": "An already validated relevant preference, never a persistent profile update.",
      "properties": {
        "key": {
          "enum": [
            "language",
            "verbosity",
            "structure",
            "explanation_depth",
            "code_presentation",
            "examples"
          ],
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Preference",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "task_type": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Type"
        },
        "requirements": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Task",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/Task"
    },
    "eligible_candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 8,
      "title": "Eligible Candidates",
      "type": "array"
    },
    "relevant_preferences": {
      "items": {
        "$ref": "#/$defs/Preference"
      },
      "maxItems": 12,
      "title": "Relevant Preferences",
      "type": "array"
    }
  },
  "required": [
    "task",
    "eligible_candidates"
  ],
  "title": "ClassifyRequest",
  "type": "object"
}
