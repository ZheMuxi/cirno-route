{
  "$defs": {
    "ResearchSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "base_url": {
          "default": "https://api.deepseek.com/v1",
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "default": "deepseek-flash",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "DEEPSEEK_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "api_key_file": {
          "default": ".runtime/deepseek.token",
          "title": "Api Key File",
          "type": "string"
        },
        "search_base_url": {
          "default": "https://api.deepseek.com/v1/tools",
          "title": "Search Base Url",
          "type": "string"
        },
        "search_api_key_env": {
          "default": "DEEPSEEK_API_KEY",
          "title": "Search Api Key Env",
          "type": "string"
        },
        "search_api_key_file": {
          "default": ".runtime/deepseek.token",
          "title": "Search Api Key File",
          "type": "string"
        },
        "cache_dir": {
          "default": ".runtime/model-capabilities",
          "title": "Cache Dir",
          "type": "string"
        },
        "ttl_hours": {
          "default": 168,
          "maximum": 720,
          "minimum": 1,
          "title": "Ttl Hours",
          "type": "integer"
        },
        "unknown_ttl_hours": {
          "default": 1,
          "maximum": 24,
          "minimum": 1,
          "title": "Unknown Ttl Hours",
          "type": "integer"
        },
        "concurrency": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "search_count": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Search Count",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "failure_retry_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 30,
          "title": "Failure Retry Seconds",
          "type": "integer"
        }
      },
      "title": "ResearchSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability_research": {
      "$ref": "#/$defs/ResearchSettings"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "runtime_url": {
      "default": "http://127.0.0.1:18080",
      "title": "Runtime Url",
      "type": "string"
    },
    "model": {
      "default": "cirno-gemma-e4b",
      "title": "Model",
      "type": "string"
    },
    "checkpoint": {
      "default": "HauhauCS/Gemma-4-E4B-Uncensored-HauhauCS-Aggressive:Q4_K_M",
      "title": "Checkpoint",
      "type": "string"
    },
    "runtime_token_file": {
      "default": ".runtime/llama.token",
      "title": "Runtime Token File",
      "type": "string"
    },
    "api_token_file": {
      "default": ".runtime/api.token",
      "title": "Api Token File",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 90.0,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "max_output_tokens": {
      "default": 1536,
      "maximum": 4096,
      "minimum": 256,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "context_tokens": {
      "default": 8192,
      "maximum": 32768,
      "minimum": 4096,
      "title": "Context Tokens",
      "type": "integer"
    },
    "max_input_bytes": {
      "default": 10000,
      "maximum": 100000,
      "minimum": 256,
      "title": "Max Input Bytes",
      "type": "integer"
    },
    "format_retries": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Format Retries",
      "type": "integer"
    },
    "compact_protocol": {
      "default": false,
      "title": "Compact Protocol",
      "type": "boolean"
    },
    "fallback_order": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Fallback Order",
      "type": "array"
    },
    "lock_file": {
      "default": ".runtime/model-lock.json",
      "title": "Lock File",
      "type": "string"
    }
  },
  "title": "Settings",
  "type": "object"
}
